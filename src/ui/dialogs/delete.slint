import { ScrollView } from "std-widgets.slint";
import { Palette } from "../theme.slint";
import { SeatOption } from "../types.slint";
import { Divider } from "../widgets/divider.slint";
import { Images } from "../images.slint";

export component DeleteDialog {
    in property <bool> shown;
    in property <string> seat-id;

    callback confirmed(string);
    callback cancelled;

    if shown: Rectangle {
        background: #00000088;

        // Dismiss on backdrop click
        TouchArea {
            clicked => { root.cancelled(); }
        }

        card := Rectangle {
            width: 320px;
            // height: card-col.preferred-height + 48px;
            height: card-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Palette.surface;
            border-color: Palette.border;
            border-width: 1px;
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000cc;

            // Block backdrop click from passing through
            TouchArea { }

            card-col := VerticalLayout {
                padding: 28px;
                spacing: 14px;
                alignment: start;

                // Icon
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: Palette.danger.with-alpha(0.12);

                        Image {
                            width: 24px;
                            height: 24px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: Images.warn;
                            colorize: Palette.danger-hi;
                        }
                    }
                }

                Text {
                    text: "Delete seat?";
                    color: Palette.text;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "All devices will be moved back to the Master seat.";
                    color: Palette.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // Seat ID badge
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: badge-lbl.preferred-width + 20px;
                        height: 26px;
                        border-radius: 6px;
                        background: Palette.surface-hi;
                        border-color: Palette.border;
                        border-width: 1px;

                        badge-lbl := Text {
                            text: seat-id;
                            color: Palette.text-dim;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 4px;
                }

                HorizontalLayout {
                    spacing: 10px;

                    cancel-t := TouchArea {
                        height: 36px;
                        horizontal-stretch: 1;
                        clicked => { root.cancelled(); }

                        Rectangle {
                            border-radius: 8px;
                            background: cancel-t.has-hover ? Palette.surface-hi : Palette.border;
                            animate background { duration: 100ms; }

                            Text {
                                text: "Cancel";
                                color: Palette.text;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    confirm-t := TouchArea {
                        height: 36px;
                        horizontal-stretch: 1;
                        clicked => { root.confirmed(seat-id); }

                        Rectangle {
                            border-radius: 8px;
                            background: confirm-t.has-hover ? Palette.danger-hi : Palette.danger;
                            animate background { duration: 100ms; }

                            Text {
                                text: "Delete";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
