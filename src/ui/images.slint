export global Images {
    // Device type icons
    out property <image> gpu:        @image-url("../assets/icons/gpu.svg");
    out property <image> sound:      @image-url("../assets/icons/sound.svg");
    out property <image> device:     @image-url("../assets/icons/device.svg");

    // Seat icon
    out property <image> seat:       @image-url("../assets/icons/seat.svg");
    out property <image> seat-new:   @image-url("../assets/icons/seat-new.svg");

    // Toolbar / header actions
    out property <image> refresh:    @image-url("../assets/icons/refresh.svg");
    out property <image> search:     @image-url("../assets/icons/search.svg");
    out property <image> menu:       @image-url("../assets/icons/menu.svg");
    out property <image> close:      @image-url("../assets/icons/close.svg");
    out property <image> delete:     @image-url("../assets/icons/delete.svg");
    out property <image> chevron:    @image-url("../assets/icons/chevron.svg");

    // Dialog state icons
    out property <image> warn:       @image-url("../assets/icons/warn.svg");
    out property <image> check:      @image-url("../assets/icons/check.svg");
    out property <image> error:      @image-url("../assets/icons/error.svg");
    out property <image> listen:     @image-url("../assets/icons/listen.svg");
    out property <image> input:      @image-url("../assets/icons/input.svg");

    // App identity
    out property <image> app-icon:   @image-url("../assets/icons/app.svg");
}
